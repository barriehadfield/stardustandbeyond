node_modules/
.DS_Store
*.log
__pycache__/

# Raw Google-Docs exports used as the import source (HTML export folder and the
# .docx). Their images are already copied (organised) into source/images/, so
# these large redundant files are not committed. Kept on disk for reference.
source/Stardust and Beyond/
*.docx

# People build report - regenerated on every `npm run build`, review-only.
scripts/people-report.md

# Local corrections-console data - regenerated by `npm run build` / `npm run editor`.
public/editor-data.json

# Corrections exported from the console - transient; applied into source/people.md
# via scripts/apply-corrections.mjs, then discarded.
source/stardust-corrections*.json
